{
  "name": "merge-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local grouped rows to fixed-slot layout records with reversible placement evidence",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:oracle": "node --test tests/oracle.test.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs && npm test && npm run build",
    "test:browser": "node tests/browser/browser-test.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0"
  }
}
